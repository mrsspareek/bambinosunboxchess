# Public origin of this deployment. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL=https://chess.example.com

# Admin protection. Generate both with a password manager or cryptographic RNG.
ADMIN_ACCESS_CODE=replace-with-a-long-admin-access-code
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Persistent application-data directory for a single Node.js instance.
# Mount this path as a durable, encrypted volume in production.
UNBOX_DATA_DIR=/var/lib/unbox-chess

# Future Zing launch integration.
ZING_API_KEY=replace-with-a-server-to-server-api-key
ZING_LAUNCH_SECRET=replace-with-at-least-32-random-bytes
ZING_ALLOWED_RETURN_ORIGINS=https://zing.bambinos.live

# Optional: send completed results back to a future Zing webhook.
ZING_RESULTS_WEBHOOK_URL=
ZING_WEBHOOK_SECRET=

# Optional protected teacher console session (future phase).
TEACHER_ACCESS_CODE=replace-with-a-long-teacher-access-code
TEACHER_SESSION_SECRET=replace-with-at-least-32-random-bytes
